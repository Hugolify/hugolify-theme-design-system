{
  "push": {
    "border": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.surface}"
      }
    },
    "color": {
      "default": {
        "$type": "color",
        "$value": "{color.white}"
      },
      "background": {
        "$type": "color",
        "$value": "{color.dark}"
      },
      "brightness": {
        "$type": "number",
        "$value": 0.3
      }
    },
    "gradient": {
      "color": {
        "from": {
          "$type": "color",
          "$value": "{gradient.darken.color.from}"
        },
        "to": {
          "$type": "color",
          "$value": "{gradient.darken.color.to}"
        }
      },
      "stop": {
        "$type": "dimension",
        "$value": "{gradient.darken.stop.default}"
      }
    },
    "content": {
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.sm}"
      },
      "maxInlineSize": {
        "default": {
          "$type": "dimension",
          "$value": "100%"
        },
        "tablet": {
          "$type": "dimension",
          "$value": "50%"
        },
        "laptop": {
          "$type": "dimension",
          "$value": "33.33%"
        }
      },
      "padding": {
        "block": {
          "$type": "dimension",
          "$value": "{spacing.fluid.md}"
        },
        "inline": {
          "$type": "dimension",
          "$value": "{spacing.fluid.md}"
        }
      }
    },
    "card": {
      "padding": {
        "block": {
          "$type": "dimension",
          "$value": "{spacing.fluid.md}"
        },
        "inline": {
          "$type": "dimension",
          "$value": "{spacing.fluid.md}"
        }
      }
    },
    "ratio": {
      "default": {
        "$type": "string",
        "$value": "{ratio.cinema}"
      },
      "double": {
        "$type": "string",
        "$value": "{ratio.photography}"
      },
      "mobile": {
        "$type": "string",
        "$value": "{ratio.landscape}"
      }
    }
  }
}
