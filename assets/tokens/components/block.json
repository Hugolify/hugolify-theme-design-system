{
  "block": {
    "card": {
      "opacity": {
        "$type": "number",
        "$value": "{theme.card.opacity}",
        "$description": "A card in a themed block is a veil of the block text colour at this opacity, see components/block-theme.css."
      }
    },
    "gap": {
      "default": {
        "$type": "dimension",
        "$value": "{spacing.fluid.md}"
      }
    },
    "padding": {
      "block": {
        "$type": "dimension",
        "$value": "{spacing.section}"
      }
    },
    "bg": {
      "color": {
        "$type": "color",
        "$value": "{color.background.muted.default}"
      }
    }
  }
}
