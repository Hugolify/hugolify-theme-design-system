{
  "items": {
    "carousel": {
      "maxWidth": {
        "$value": "75vw",
        "$type": "dimension"
      },
      "nav": {
        "borderRadius": {
          "$type": "dimension",
          "$value": "{carousel.arrow.borderRadius}"
        },
        "gap": {
          "$type": "dimension",
          "$value": "{carousel.arrow.gap}"
        },
        "icon": {
          "next": {
            "$type": "string",
            "$value": "{carousel.arrow.icon.default}"
          },
          "previous": {
            "$type": "string",
            "$value": "{carousel.arrow.icon.default}"
          },
          "size": {
            "$type": "dimension",
            "$value": "{carousel.arrow.icon.size}"
          }
        },
        "margin": {
          "blockEnd": {
            "$type": "dimension",
            "$value": "{carousel.arrow.marginBlock}"
          }
        },
        "opacity": {
          "disabled": {
            "$type": "number",
            "$value": "{carousel.arrow.opacity.disabled}"
          }
        },
        "size": {
          "$type": "dimension",
          "$value": "{carousel.arrow.size}"
        }
      },
      "pagination": {
        "border": {
          "style": {
            "$type": "string",
            "$value": "{carousel.pagination.border.style}"
          },
          "width": {
            "$type": "dimension",
            "$value": "{carousel.pagination.border.width}"
          }
        },
        "borderRadius": {
          "$type": "dimension",
          "$value": "{carousel.pagination.borderRadius}"
        },
        "color": {
          "default": {
            "$type": "color",
            "$value": "{carousel.pagination.color.default}"
          },
          "active": {
            "$type": "color",
            "$value": "{carousel.pagination.color.active}"
          },
          "border": {
            "default": {
              "$type": "color",
              "$value": "{carousel.pagination.color.border.default}"
            },
            "active": {
              "$type": "color",
              "$value": "{carousel.pagination.color.border.active}"
            },
            "hover": {
              "$type": "color",
              "$value": "{carousel.pagination.color.border.hover}"
            }
          },
          "hover": {
            "$type": "color",
            "$value": "{carousel.pagination.color.hover}"
          }
        },
        "gap": {
          "$type": "dimension",
          "$value": "{carousel.pagination.gap}"
        },
        "height": {
          "$type": "dimension",
          "$value": "{carousel.pagination.height}"
        },
        "margin": {
          "blockStart": {
            "$type": "dimension",
            "$value": "{carousel.pagination.marginBlock}"
          }
        },
        "width": {
          "$type": "dimension",
          "$value": "{carousel.pagination.width}"
        }
      }
    },
    "nav": {
      "margin": {
        "blockStart": {
          "$type": "dimension",
          "$value": "{spacing.fluid.md}"
        }
      }
    }
  }
}
